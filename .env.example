# Facebook Lead Monitor — settings template.
# Copy this file to .env and fill in your values. Never commit .env!

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI provider: none | ollama | openai ---
# "none" is the default: works on weak PCs, no AI calls at all.
AI_PROVIDER=none

# Ollama (local, free)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI (paid, optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Storage and logs (relative paths are resolved from the project folder) ---
DATABASE_PATH=data/monitor.db
# Keywords file: [include] / [exclude] sections, reloaded automatically when edited
KEYWORDS_PATH=config/keywords.txt
# Leads published earlier than this many hours are saved but not sent to Telegram
LEAD_MAX_AGE_HOURS=48
LOG_DIR=logs
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Local server for the Chrome extension ---
EXTENSION_PORT=8765
# Shared secret between the extension and the local server (any long random string)
EXTENSION_TOKEN=
