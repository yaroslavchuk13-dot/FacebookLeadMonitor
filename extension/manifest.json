{
  "manifest_version": 3,
  "name": "Facebook Lead Monitor",
  "version": "0.2.0",
  "description": "Reads selected Facebook groups and sends new posts to the local Lead Monitor app.",
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://www.facebook.com/*"],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Facebook Lead Monitor",
    "default_popup": "popup/popup.html"
  }
}
